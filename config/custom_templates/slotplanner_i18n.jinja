{%- macro t(key, a='', b='', c='', d='') -%}
{%- set lang = ((slotplanner_config() | from_json).general | default({})).language | default('en') -%}
{%- set d = T.get(lang, T.en) -%}
{{- (d.get(key) or T.en.get(key) or key) | replace('{0}', a | string) | replace('{1}', b | string) | replace('{2}', c | string) | replace('{3}', d | string) -}}
{%- endmacro -%}
